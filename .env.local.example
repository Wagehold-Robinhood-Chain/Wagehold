# Salin file ini menjadi .env.local lalu isi dari Supabase dashboard
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Jangan pernah expose ini ke browser / commit ke git.
# Hanya dipakai di Route Handler untuk aksi privileged (mis. payout).
SUPABASE_SERVICE_ROLE_KEY=

# Dipakai oleh `npm run supabase:types`
SUPABASE_PROJECT_ID=

# Research Ward (Deepdive, $DIVE) -- Fase 1 item 10. Ambil gratis dari
# https://aistudio.google.com/apikey. Tanpa ini, job Research Ward akan
# tetap dibuat tapi Deepdive gagal memprosesnya (dicatat sebagai event
# error di Ledger, job kembali ke status 'open', wage tetap aman).
GEMINI_API_KEY=

# Opsional -- override model per environment tanpa mengubah database.
# Default: gemini-2.0-flash (lihat lib/agents/gemini.ts).
GEMINI_MODEL=

# Wallet connect (Fase 2 item 5) -- Reown AppKit (WalletConnect). Ambil gratis dari
# https://cloud.reown.com -- ini bukan rahasia, memang dibaca di browser (identifikasi app
# ke jaringan relay WalletConnect, bukan kredensial). Tanpa ini, tombol Connect wallet di
# header tampil nonaktif tapi seluruh app tetap jalan (lihat components/web3-provider.tsx
# dan components/wallet-connect.tsx) -- dan Fase 2 item 6 di bawah otomatis jatuh ke alur
# simulasi lama (escrow database, bukan on-chain sungguhan).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Opsional -- RPC Robinhood Chain buat WalletConnect membaca state on-chain dari browser,
# DAN dipakai server-side oleh lib/web3/verify-lock.ts (Fase 2 item 6) untuk memverifikasi
# klaim lock sebelum menyimpan job. Kosongkan untuk pakai endpoint publik (rate-limited,
# cukup untuk coba-coba lokal); isi dengan URL Alchemy (lihat contracts/.env.example) untuk
# trafik sungguhan -- domain-restrict key-nya dulu di dashboard Alchemy sebelum dipakai di
# sini, karena NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL ke-expose ke browser.
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=

# Fase 2 item 6 -- "Post a Job -> lock wage on-chain sungguhan". Isi dengan alamat yang
# dicetak `forge script script/Deploy.s.sol --broadcast` (lihat contracts/DEPLOY_REHEARSAL.md)
# setelah item 4 benar-benar di-broadcast ke Robinhood Chain testnet. Kosong -> Post a Job
# jatuh ke alur simulasi lama (wage dicatat di Postgres saja, tidak benar-benar terkunci di
# WageholdStrongbox) -- lihat lib/web3/strongbox.ts (isOnChainEscrowConfigured).
NEXT_PUBLIC_STRONGBOX_ADDRESS=
# Alamat token wage (MockUSDC dari deploy rehearsal, atau USDC sungguhan di Robinhood Chain
# begitu ada) -- WageholdStrongbox butuh allowance ERC20 sebelum createJob bisa dipanggil,
# lib/web3/lock-wage.ts yang menangani approve-nya otomatis kalau allowance belum cukup.
NEXT_PUBLIC_WAGE_TOKEN_ADDRESS=

# Fase 2 item 7 -- "Set the seal -> release escrow on-chain sungguhan". SERVER-ONLY: jangan
# pernah diberi awalan NEXT_PUBLIC_ dan jangan di-commit.
#
# COUNCIL_PRIVATE_KEY harus private key dari alamat yang sama dengan `council()` di
# WageholdStrongbox (dan WageholdSplitter kalau dipakai) -- COUNCIL_ADDRESS saat deploy.
# WageholdStrongbox.approve() revert `PayeeNotSet` sampai council mendaftarkan payee, jadi
# route POST /api/jobs/:id/seal/prepare memakai key ini untuk setPayee (+ registerJob di
# Splitter) SEBELUM wallet client menyegel, dan /approve memakai key yang sama sebagai akun
# pengirim pullAndSplit (permissionless) setelah seal. Payee dihitung dari database (Wright
# yang di-assign ke job), tidak pernah dari request client. Pakai wallet testnet terpisah
# berisi sedikit ETH untuk gas -- BUKAN wallet berisi dana sungguhan.
COUNCIL_PRIVATE_KEY=

# Alamat WageholdSplitter (dari output deploy). Diisi -> payee job = Splitter dan wage dibagi
# 70/20/10 on-chain lewat pullAndSplit. Kosong -> payee = agents.wallet milik Wright dan tidak
# ada pembagian (cuma masuk akal buat coba-coba awal di testnet).
WAGEHOLD_SPLITTER_ADDRESS=

# Opsional -- alamat Patron pool cadangan kalau agents.wallet Wright kosong (seed belum
# mengisi kolom itu). Wajib diisi kalau Splitter dipakai tapi wallet Wright belum ada.
# Distribusi ke Patron sungguhan itu Fase 4.
WAGEHOLD_PATRON_POOL_ADDRESS=
