# Salin file ini menjadi .env.local lalu isi dari Supabase dashboard
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Jangan pernah expose ini ke browser / commit ke git.
# Hanya dipakai di Route Handler untuk aksi privileged (mis. payout).
SUPABASE_SERVICE_ROLE_KEY=

# Dipakai oleh `npm run supabase:types`
SUPABASE_PROJECT_ID=

# Research Ward (Deepdive, $DIVE) -- Fase 1 item 10. Ambil gratis dari
# https://aistudio.google.com/apikey. Tanpa ini, job Research Ward akan
# tetap dibuat tapi Deepdive gagal memprosesnya (dicatat sebagai event
# error di Ledger, job kembali ke status 'open', wage tetap aman).
GEMINI_API_KEY=

# Opsional -- override model per environment tanpa mengubah database.
# Kalau diisi, nilai ini MENANG atas agents.model di database.
# Default: gemini-3.8-flash (lihat lib/agents/gemini.ts).
GEMINI_MODEL=gemini-3.8-flash

# Opsional -- model cadangan kalau model utama sibuk (503) berkali-kali.
# Dipakai pada percobaan terakhir. Cek ID persisnya di daftar model API key kamu
# (curl "https://generativelanguage.googleapis.com/v1beta/models?key=API_KEY").
# Kalau ID salah -> 404 dan fallback tidak berfungsi. Kosongkan kalau tidak perlu.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Wallet connect (Fase 2 item 5) -- Reown AppKit (WalletConnect). Ambil gratis dari
# https://cloud.reown.com -- ini bukan rahasia, memang dibaca di browser (identifikasi app
# ke jaringan relay WalletConnect, bukan kredensial). Tanpa ini, tombol Connect wallet di
# header tampil nonaktif tapi seluruh app tetap jalan (di mode simulasi tombol memang nonaktif,
# wallet belum diperlukan) (lihat components/web3-provider.tsx
# dan components/wallet-connect.tsx) -- dan Fase 2 item 6 di bawah otomatis jatuh ke alur
# simulasi lama (escrow database, bukan on-chain sungguhan).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Opsional -- RPC Robinhood Chain buat WalletConnect membaca state on-chain dari browser,
# DAN dipakai server-side oleh lib/web3/verify-lock.ts (Fase 2 item 6) untuk memverifikasi
# klaim lock sebelum menyimpan job. Kosongkan untuk pakai endpoint publik (rate-limited,
# cukup untuk coba-coba lokal); isi dengan URL Alchemy (lihat contracts/.env.example) untuk
# trafik sungguhan -- domain-restrict key-nya dulu di dashboard Alchemy sebelum dipakai di
# sini, karena NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL ke-expose ke browser.
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=

# Pembayaran wage memakai satu token saja: $WAGE (tidak ada token per-agent).
#
# TIDAK ADA LOGIN. Identitas ditentukan oleh mode di bawah (lib/identity/mode.ts).
#
# MODE SIMULASI (default): biarkan NEXT_PUBLIC_STRONGBOX_ADDRESS dan
# NEXT_PUBLIC_WAGE_TOKEN_ADDRESS KOSONG. Post a Job dan Set the seal hanya mencatat wage di
# Postgres -- tidak ada token bergerak, tidak perlu connect wallet. Pemilik job = browser yang
# membuatnya (cookie httpOnly `wh_sim`; hapus cookie = kehilangan akses seal job lama). Agent
# tetap bekerja seperti biasa. Label di UI tetap "$WAGE" / "WAGE" (lihat lib/currency.ts).
#
# MODE ON-CHAIN / WALLET: aktif hanya kalau KEDUA env di bawah terisi -- dan saat itu user WAJIB
# connect wallet untuk Post a Job / Set the seal / Send back (pemilik job = wallet yang
# mengunci wage). Urutannya:
#   1. Deploy contracts/ dengan WAGE_TOKEN_ADDRESS=<CA $WAGE> (lihat
#      contracts/DEPLOY_REHEARSAL.md). Jangan biarkan kosong: Deploy.s.sol akan membuat
#      MockUSDC yang mint()-nya terbuka untuk siapa saja. WageholdStrongbox menyimpan token
#      secara immutable, jadi salah token = harus deploy ulang.
#   2. Isi NEXT_PUBLIC_WAGE_TOKEN_ADDRESS dengan CA $WAGE yang sama, dan
#      NEXT_PUBLIC_STRONGBOX_ADDRESS dengan alamat Strongbox dari output deploy.
#   3. Isi juga NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID (di atas) dan COUNCIL_PRIVATE_KEY
#      (di bawah) supaya wallet bisa connect dan Set the seal bisa jalan.
# CA token saja TIDAK cukup menyalakan mode on-chain: escrow butuh Strongbox yang sudah
# di-deploy. Decimals token dibaca otomatis dari kontrak (tidak diasumsikan 6).
NEXT_PUBLIC_STRONGBOX_ADDRESS=
NEXT_PUBLIC_WAGE_TOKEN_ADDRESS=

# Jaringan yang dipakai di MODE ON-CHAIN: "mainnet" (Robinhood Chain, 4663) atau "testnet"
# (46630). Kosong = testnet. Menentukan jaringan default AppKit, RPC server (verifikasi lock,
# seal, tanda tangan wallet), kunci council, dan link explorer. Wallet di jaringan lain
# ditandai "Wrong network". Tidak berpengaruh selama mode simulasi.
NEXT_PUBLIC_WAGEHOLD_NETWORK=

# Fase 2 item 7 -- "Set the seal -> release escrow on-chain sungguhan". SERVER-ONLY: jangan
# pernah diberi awalan NEXT_PUBLIC_ dan jangan di-commit.
#
# COUNCIL_PRIVATE_KEY harus private key dari alamat yang sama dengan `council()` di
# WageholdStrongbox (dan WageholdSplitter kalau dipakai) -- COUNCIL_ADDRESS saat deploy.
# WageholdStrongbox.approve() revert `PayeeNotSet` sampai council mendaftarkan payee, jadi
# route POST /api/jobs/:id/seal/prepare memakai key ini untuk setPayee (+ registerJob di
# Splitter) SEBELUM wallet client menyegel, dan /approve memakai key yang sama sebagai akun
# pengirim pullAndSplit (permissionless) setelah seal. Payee dihitung dari database (Wright
# yang di-assign ke job), tidak pernah dari request client. Pakai wallet testnet terpisah
# berisi sedikit ETH untuk gas -- BUKAN wallet berisi dana sungguhan.
COUNCIL_PRIVATE_KEY=

# Alamat WageholdSplitter (dari output deploy). Diisi -> payee job = Splitter dan wage dibagi
# 60/20/10/10 on-chain lewat pullAndSplit. Kosong -> payee = agents.wallet milik Wright dan tidak
# ada pembagian (cuma masuk akal buat coba-coba awal di testnet).
WAGEHOLD_SPLITTER_ADDRESS=

# Opsional -- alamat Patron pool cadangan kalau agents.wallet Wright kosong (seed belum
# mengisi kolom itu). Wajib diisi kalau Splitter dipakai tapi wallet Wright belum ada.
# Distribusi ke Patron sungguhan itu Fase 4.
WAGEHOLD_PATRON_POOL_ADDRESS=

# ---------------------------------------------------------------------------
# THE WEIGHHOUSE ($WAGE Monitor) -- Dev Brief v1.0. Alamat tetap ada di lib/web3/addresses.ts.
# ---------------------------------------------------------------------------
# Jalankan dulu:  npx tsx --env-file=.env.local scripts/weighhouse-discover.ts
# Skrip itu membaca chain dan mencetak nilai yang benar untuk DEPLOY_BLOCK, WAGE_CURVE, PAIR_TOKEN dan
# NEXT_PUBLIC_WAGE_GRADUATED_AT -- tempel hasilnya di sini.
#
# Wajib agar cron/indexer jalan:
WEIGHHOUSE_DEPLOY_BLOCK=
# Rahasia untuk /api/cron/index-chain (dikirim sebagai Bearer oleh Supabase pg_cron; nilai yang sama disimpan di Vault, lihat 0016_weighhouse_cron.sql):
CRON_SECRET=
# Pasar $WAGE di Pons V2 (dari skrip discover). Kosong = fitur terkait mati dengan anggun:
# bonding curve per-token (pra-graduation): saldo curve + trade curve
WEIGHHOUSE_WAGE_CURVE=
# quote asset launch; kosong = ETH native (default Pons)
WEIGHHOUSE_PAIR_TOKEN=
# opsional: blok launch $WAGE -> volume trading dihitung sejak launch
WEIGHHOUSE_MARKET_START_BLOCK=
# fallback garis graduation di grafik harga (normalnya diambil dari event PoolGraduated)
NEXT_PUBLIC_WAGE_GRADUATED_AT=
# Pool ID v4 DIHITUNG otomatis dari token + hook Pons -- isi hanya untuk menimpa:
WEIGHHOUSE_V4_POOL_ID=
# Opsional: StateView v4. Kosong = baca state pool lewat PoolManager.extsload (layout diverifikasi runtime):
WEIGHHOUSE_V4_STATE_VIEW=
# Sumber harga utama (cube Trading, curve + pool v4). Tanpa key: harga on-chain, hanya pasca-graduation:
BITQUERY_API_KEY=
# Opsional: Chainlink ETH/USD di Robinhood Chain, dipakai hanya untuk harga on-chain saat quote = ETH:
WEIGHHOUSE_ETH_USD_FEED=
# Link halaman Pons $WAGE (disembunyikan kalau kosong; tidak ada format URL token Pons yang terverifikasi):
NEXT_PUBLIC_PONS_TOKEN_URL=
