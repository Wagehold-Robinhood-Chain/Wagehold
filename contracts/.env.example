# Salin file ini menjadi .env di folder contracts/ ini (BUKAN .env.local milik app Next.js
# di root -- dua env terpisah, foundry.toml cuma baca yang di sini).

# Ambil API key dari https://dashboard.alchemy.com/signup -- buat app baru, pilih network
# "Robinhood Chain" (testnet atau mainnet). Alchemy adalah penyedia RPC yang direkomendasikan
# resmi oleh docs.robinhood.com/chain untuk pemakaian produksi (endpoint publik
# rpc.testnet.chain.robinhood.com dibatasi rate-limit, cuma cocok buat coba-coba cepat).
ROBINHOOD_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/GANTI_DENGAN_API_KEY
ROBINHOOD_MAINNET_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/GANTI_DENGAN_API_KEY

# Opsional -- cuma dipakai kalau verifikasi kontrak lewat `forge verify-contract` memakai
# config [etherscan] di foundry.toml. Kalau verifier Blockscout tidak minta API key (banyak
# yang tidak), boleh dikosongkan / isi string apa saja; command verifikasi langsung
# (`--verifier blockscout --verifier-url ...`) tidak butuh ini sama sekali.
ROBINHOOD_VERIFIER_KEY=

# Private key wallet yang dipakai buat deploy (item 4, script/Deploy.s.sol belum ada).
# JANGAN PERNAH commit private key sungguhan -- pakai wallet testnet terpisah yang cuma
# berisi ETH faucet, jangan wallet yang sama dengan dana sungguhan.
DEPLOYER_PRIVATE_KEY= 0x24a42699aaf18d8a12667b3a599fb149bc7747851f2504bfc78d11d06977245e
