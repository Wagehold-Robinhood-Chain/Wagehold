# Salin menjadi scripts/.env.e2e (di-gitignore). Yang belum diisi di sini dibaca dari .env.local,
# jadi kalau .env.local app sudah berisi alamat kontrak + COUNCIL_PRIVATE_KEY, cukup isi
# E2E_CLIENT_PRIVATE_KEY.
#
# SEMUA KUNCI DI SINI: wallet testnet khusus yang hanya berisi ETH faucet. Jangan wallet asli.

# RPC Robinhood Chain testnet (chain id 46630). Pakai URL Alchemy -- satu run mengirim ~35
# transaksi per mode, endpoint publik yang rate-limited bisa gagal di tengah jalan.
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/GANTI_DENGAN_API_KEY

# Alamat dari output `forge script script/Deploy.s.sol --broadcast`
NEXT_PUBLIC_STRONGBOX_ADDRESS=
NEXT_PUBLIC_WAGE_TOKEN_ADDRESS=
WAGEHOLD_SPLITTER_ADDRESS=

# Harus alamat yang sama dengan council() -- dengan Deploy.s.sol default, itu DEPLOYER_PRIVATE_KEY.
# Pakai juga untuk mint MockUSDC ke client (kalau token-nya MockUSDC dari Deploy.s.sol).
COUNCIL_PRIVATE_KEY=

# Wallet "client" yang mengunci wage dan menyegel. WAJIB berbeda dari council (uji NotClient).
# Butuh sedikit ETH faucet untuk gas (~0.002 ETH cukup).
E2E_CLIENT_PRIVATE_KEY=

# Opsional: kunci alamat Lamp Oil / Tithe kalau berbeda dari council. Kalau kosong dan
# alamatnya bukan council, script hanya membuktikan ledger Splitter (tanpa menarik).
E2E_LAMP_OIL_PRIVATE_KEY=
E2E_TITHE_PRIVATE_KEY=

# Opsional
E2E_WAGE_UNITS=100          # wage per job dalam satuan token (bukan unit dasar)
E2E_GAS_TOPUP_ETH=0.0005    # ETH yang dikirim client ke akun Wright sekali-pakai buat gas withdraw
